SERVICE_NAME=Notificaciones
SERVICE_PORT=8005

# Cliente de IA generativa para redactar las alertas de WhatsApp (demeter_core.ai_client).
# Si AI_MESSAGES_ENABLED=false (por defecto), se usa siempre la plantilla fija y
# no se realiza ninguna llamada de red a un proveedor de IA.
AI_MESSAGES_ENABLED=false
AI_PROVIDER=claude
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
